{
  "name": "@multiversx/sdk-dapp-swap",
  "version": "4.3.0",
  "description": "A library to hold the main logic for swapping between tokens on the MultiversX blockchain",
  "author": "MultiversX",
  "license": "GPL-3.0-or-later",
  "repository": "multiversx/mx-sdk-dapp-swap",
  "main": "./__commonjs",
  "module": "./",
  "types": "./",
  "react-native": "./",
  "scripts": {
    "start": "npm run watch",
    "build:esm": "tsc --project tsconfig.json && tsc-alias --project tsconfig.json",
    "build:cjs": "tsc --project tsconfig.cjs.json && tsc-alias --project tsconfig.cjs.json",
    "build": "rimraf dist && npm run build:esm && npm run build:cjs && cp package.json dist && cp README.md dist",
    "publish-package": "npm run test && npm run build && cd dist && npm publish",
    "publish-package-next": "npm run test && npm run build && cd dist && npm publish --tag next",
    "publish-yalc": "npm run build && cd dist && yalc publish --push",
    "unpublish-verdaccio": "npm unpublish @multiversx/sdk-dapp-swap --force --registry http://localhost:4873",
    "publish-verdaccio": "npm run unpublish-verdaccio && npm run build && cd dist && npm publish --registry http://localhost:4873/",
    "watch": "tsc-alias --project tsconfig.json --watch & tsc --project tsconfig.json --watch",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@apollo/client": "3.14.1",
    "@multiversx/sdk-core": "^15.x",
    "@multiversx/sdk-dapp": "^5.x",
    "@size-limit/preset-small-lib": "7.0.8",
    "@swc/core": "^1.13.0",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "5.16.4",
    "@testing-library/react": "13.3.0",
    "@tsconfig/create-react-app": "1.0.2",
    "@tsconfig/recommended": "1.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "20.17.0",
    "@types/react": "18.2.24",
    "@types/react-dom": "18.2.8",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "axios": "^1.16.1",
    "bignumber.js": "^9.x",
    "eslint": "8.57.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-react": "1.1.7",
    "eslint-config-standard": "17.1.0",
    "eslint-config-standard-react": "13.0.0",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-promise": "6.0.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.0",
    "graphql": ">=16.9.0",
    "graphql-ws": "6.0.3",
    "husky": "8.0.1",
    "identity-obj-proxy": "3.0.0",
    "jest": "28.1.3",
    "jest-css-modules-transform": "4.4.2",
    "jest-environment-jsdom": "28.1.3",
    "msw": "0.48.2",
    "postcss-modules": "4.3.1",
    "prettier": "3.8.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "18.0.0",
    "react-scripts": "5.0.1",
    "rimraf": "^6.1.2",
    "size-limit": "7.0.8",
    "tsc-alias": "^1.8.17",
    "tslib": "2.4.0",
    "typescript": "4.8.4"
  },
  "files": [
    "*.js",
    "**/*.js",
    "*.d.ts",
    "**/*.d.ts"
  ],
  "keywords": [
    "multiversx",
    "blockchain",
    "dapp",
    "smart-contract",
    "transaction"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@apollo/client": "^3.14.1",
    "@multiversx/sdk-core": "^14.0.0 || ^15.0.0",
    "@multiversx/sdk-dapp": "^5.x",
    "axios": "^1.16.1",
    "bignumber.js": "^9.x",
    "graphql": ">=16.9.0",
    "graphql-ws": "^6.0.3",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@multiversx/sdk-dapp-utils": "^3.x",
    "anchorme": "2.1.2",
    "bech32": "2.0.0",
    "formik": "2.2.9",
    "react-bootstrap-typeahead": "6.4.1",
    "react-select": "5.4.0",
    "yup": "0.32.11"
  }
}
