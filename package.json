{
  "name": "@multiversx/sdk-dapp-swap",
  "version": "4.4.0-alpha.0",
  "description": "A library to hold the main logic for swapping between tokens on the MultiversX blockchain",
  "author": "MultiversX",
  "license": "GPL-3.0-or-later",
  "repository": "multiversx/mx-sdk-dapp-swap",
  "main": "./__commonjs",
  "module": "./",
  "types": "./",
  "react-native": "./",
  "scripts": {
    "start": "npm run watch",
    "build:esm": "tsc --project tsconfig.json && tsc-alias --project tsconfig.json",
    "build:cjs": "tsc --project tsconfig.cjs.json && tsc-alias --project tsconfig.cjs.json",
    "build": "rimraf dist && npm run build:esm && npm run build:cjs && cp package.json dist && cp README.md dist",
    "publish-package": "npm run test && npm run build && cd dist && npm publish",
    "publish-package-next": "npm run test && npm run build && cd dist && npm publish --tag next",
    "publish-yalc": "npm run build && cd dist && yalc publish --push",
    "unpublish-verdaccio": "npm unpublish @multiversx/sdk-dapp-swap --force --registry http://localhost:4873",
    "publish-verdaccio": "npm run unpublish-verdaccio && npm run build && cd dist && npm publish --registry http://localhost:4873/",
    "watch": "tsc-alias --project tsconfig.json --watch & tsc --project tsconfig.json --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@apollo/client": "3.14.1",
    "@multiversx/sdk-core": "^15.x",
    "@multiversx/sdk-dapp": "^5.x",
    "@swc/core": "^1.13.0",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "24.13.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "bignumber.js": "^9.x",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.9.0",
    "graphql": "^16.14.2",
    "graphql-ws": "6.2.1",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "prettier": "3.9.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rimraf": "^6.1.2",
    "tsc-alias": "^1.8.17",
    "typescript": "5.9.3"
  },
  "files": [
    "*.js",
    "**/*.js",
    "*.d.ts",
    "**/*.d.ts"
  ],
  "keywords": [
    "multiversx",
    "blockchain",
    "dapp",
    "smart-contract",
    "transaction"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@apollo/client": "^3.14.1",
    "@multiversx/sdk-core": "^14.0.0 || ^15.0.0 || ^16.0.0",
    "@multiversx/sdk-dapp": "^5.x",
    "bignumber.js": "^9.x",
    "graphql": ">=16.9.0",
    "graphql-ws": "^6.0.3",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@multiversx/sdk-dapp-utils": "^3.x",
    "formik": "2.4.9",
    "react-select": "5.10.2",
    "yup": "1.7.1"
  }
}
